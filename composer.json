{
    "name": "ridhof/optiguard-laravel",
    "description": "Enterprise Backend Security Suite for Laravel: Anti-Session Hijacking, Device Fingerprinting, Security Headers & OptiGuard Telemetry.",
    "keywords": ["laravel", "security", "anti-hijacking", "session-protection", "device-fingerprint", "security-headers", "optiguard"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ridho",
            "email": "ridho@appdutamall.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "OptiGuard\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OptiGuard\\Laravel\\OptiGuardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
